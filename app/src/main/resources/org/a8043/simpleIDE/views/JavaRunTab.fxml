<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.web.WebView?>
<SplitPane dividerPositions="0.5" orientation="VERTICAL" xmlns="http://javafx.com/javafx/24.0.1"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.a8043.simpleIDE.views.JavaRunTab">
    <items>
        <WebView fx:id="terminal"/>
        <BorderPane>
            <center>
                <TabPane fx:id="infoTabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE"/>
            </center>
            <top>
                <HBox prefHeight="0.0" prefWidth="800.0" BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="stopButton" mnemonicParsing="false" onAction="#stop" text="stop"/>
                    </children>
                </HBox>
            </top>
        </BorderPane>
    </items>
</SplitPane>
