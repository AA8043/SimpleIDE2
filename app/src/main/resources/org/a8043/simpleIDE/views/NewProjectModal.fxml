<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.a8043.simpleIDE.views.NewProjectModal">
    <children>
        <SplitPane dividerPositions="0.2976501305483029">
            <items>
                <ListView fx:id="typeListView" prefHeight="200.0" prefWidth="200.0"/>
                <ScrollPane>
                    <content>
                        <VBox fx:id="configurationPane" maxWidth="1.7976931348623157E308">
                            <children>
                                <GridPane>
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="name"/>
                                        <Label text="location" GridPane.rowIndex="1"/>
                                        <Label text="buildTool" GridPane.rowIndex="2"/>
                                        <TextField fx:id="nameField" GridPane.columnIndex="1"/>
                                        <TextField fx:id="locationField" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1"/>
                                        <ComboBox fx:id="buildToolBox" prefWidth="150.0" GridPane.columnIndex="1"
                                                  GridPane.rowIndex="2"/>
                                        <Label text="jdk" GridPane.rowIndex="3"/>
                                        <ComboBox fx:id="jdkBox" prefWidth="150.0" GridPane.columnIndex="1"
                                                  GridPane.rowIndex="3"/>
                                        <Label text="groupId" GridPane.rowIndex="4"/>
                                        <Label text="artifactId" GridPane.rowIndex="5"/>
                                        <TextField fx:id="groupIdField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                        <TextField fx:id="artifactIdField" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="5"/>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </items>
        </SplitPane>
        <Separator prefWidth="200.0"/>
        <HBox alignment="CENTER_RIGHT" prefHeight="29.0" prefWidth="202.0">
            <children>
                <Button maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#create" text="ok"/>
            </children>
        </HBox>
    </children>
</VBox>
