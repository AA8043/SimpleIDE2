<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.a8043.simpleIDE.views.GitPushModal">
    <children>
        <ListView fx:id="pushList"/>
        <Separator prefWidth="200.0"/>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <CheckBox fx:id="forceBox" mnemonicParsing="false" text="git.force"/>
                <Button mnemonicParsing="false" onAction="#push" text="git.push"/>
            </children>
        </HBox>
    </children>
</VBox>
