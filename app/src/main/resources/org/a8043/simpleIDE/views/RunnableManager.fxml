<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<SplitPane dividerPositions="0.2868217054263566" xmlns="http://javafx.com/javafx/24.0.1"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.a8043.simpleIDE.views.RunnableManager">
    <items>
        <VBox prefHeight="200.0" prefWidth="100.0">
            <children>
                <HBox prefHeight="42.0" prefWidth="100.0">
                    <children>
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#add" text="+"/>
                        <Button fx:id="removeButton" mnemonicParsing="false" onAction="#remove" text="-"/>
                    </children>
                </HBox>
                <ListView fx:id="listView" prefHeight="200.0" prefWidth="200.0"/>
            </children>
        </VBox>
        <VBox fx:id="contentBox" prefHeight="200.0" prefWidth="100.0"/>
    </items>
</SplitPane>
